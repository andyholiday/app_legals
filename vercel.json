{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/shiptrip/privacy-de", "destination": "https://shiptrip.jahaus.de/datenschutz/", "permanent": true },
    { "source": "/shiptrip/privacy-en", "destination": "https://shiptrip.jahaus.de/en/privacy/", "permanent": true },
    { "source": "/shiptrip", "destination": "https://shiptrip.jahaus.de/", "permanent": true },
    { "source": "/shiptrip/:path*", "destination": "https://shiptrip.jahaus.de/", "permanent": true }
  ]
}
